{
    "name": "terminal-e2e",
    "private": true,
    "type": "module",
    "description": "Aviary's end-to-end tests: Playwright on the local run at 1440, 390 and 360 px in both themes (docs/spec/pipescope-architecture.md, Build tickets)",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "typecheck": "tsc -p .",
        "e2e": "playwright test",
        "record": "E2E_RPC=record playwright test",
        "deployed": "playwright test -c playwright.deployed.config.ts",
        "swaps:devnet": "E2E_SWAPS=1 E2E_RPC=devnet playwright test --project swaps",
        "wallet:devnet": "E2E_WALLET_DEVNET=1 E2E_RPC=devnet playwright test --project wallet-devnet",
        "tax:devnet": "E2E_TAX_DEVNET=1 E2E_RPC=devnet playwright test --project tax-devnet",
        "containment:devnet": "E2E_CONTAINMENT_DEVNET=1 E2E_RPC=devnet playwright test --project containment-devnet",
        "lending:devnet": "E2E_LENDING_DEVNET=1 E2E_RPC=devnet playwright test --project lending-devnet",
        "wrap-sol": "node demo/wrap-sol.ts",
        "hooked:setup": "node demo/hooked-mints.ts",
        "hooked:local": "E2E_RPC=local playwright test --project hooked",
        "demo:versions": "node demo/strategy-versions.ts",
        "demo:canary": "node demo/canary-runs.ts"
    },
    "devDependencies": {
        "@pipeline-sol/sdk": "catalog:",
        "@playwright/test": "1.65.1",
        "@solana-program/system": "0.16.0",
        "@solana-program/token": "0.18.0",
        "@solana-program/token-2022": "0.20.0",
        "@solana/kit": "8.6.0",
        "@types/node": "24.19.2",
        "@types/ws": "8.18.1",
        "containment-hook-scripts": "workspace:*",
        "drizzle-orm": "0.45.4",
        "jsonc-parser": "3.3.1",
        "postgres": "3.4.9",
        "tax-amm-scripts": "workspace:*",
        "terminal-api": "workspace:*",
        "terminal-db": "workspace:*",
        "terminal-devnet": "workspace:*",
        "terminal-indexer": "workspace:*",
        "typescript": "6.0.3",
        "ws": "8.22.2"
    }
}

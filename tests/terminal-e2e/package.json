{
    "name": "terminal-e2e",
    "private": true,
    "type": "module",
    "description": "Aviary's end-to-end tests: Playwright on the local run at 1440, 390 and 360 px in both themes (docs/spec/pipescope-architecture.md, Build tickets)",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "typecheck": "tsc -p .",
        "e2e": "playwright test",
        "record": "E2E_RPC=record playwright test"
    },
    "devDependencies": {
        "@playwright/test": "1.65.1",
        "@solana/kit": "8.6.0",
        "@types/node": "24.19.2",
        "@types/ws": "8.18.1",
        "postgres": "3.4.9",
        "terminal-api": "workspace:*",
        "terminal-db": "workspace:*",
        "terminal-devnet": "workspace:*",
        "terminal-indexer": "workspace:*",
        "typescript": "6.0.3",
        "ws": "8.22.2"
    }
}

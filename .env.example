# The project's .env, which direnv loads after ~/.config/env/global.env (docs/toolchain.md,
# "Aviary's local run"). Copy it to .env in the main checkout; .env is never committed.

# Aviary's Solana RPC: Aviary's own Helius devnet key, HELIUS_API_KEY_PIPELINE in ~/.config/env/global.env.
RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY_PIPELINE}

# Aviary's database: the Docker Postgres of packages/terminal-db/docker-compose.yml.
DATABASE_URL=postgres://terminal:terminal@127.0.0.1:5462/terminal

# The hosted deployment's database (#192, PIPESCOPE-170): the Neon project terminal-devnet's direct
# connection string, read only by `pnpm terminal:deploy`, which migrates it; the Hyperdrive
# terminal-devnet was made from it. Never point a local run or the e2e suite at it.
NEON_DATABASE_URL=

# The keeper runner's heartbeat (SUITE-57): its launchd agent posts one after every pass to Aviary's
# API, so the keeper page knows it is running; its records go to DATABASE_URL above.
KEEPER_HEARTBEAT_URL=http://localhost:8811/keeper/heartbeat

{
    "name": "terminal-db",
    "private": true,
    "type": "module",
    "description": "Aviary's Postgres: the Drizzle schema, its migrations and the local Docker database (docs/spec/pipescope-architecture.md, Data)",
    "engines": {
        "node": ">=24 <25"
    },
    "exports": {
        ".": "./src/index.ts",
        "./keeper": "./src/keeper.ts",
        "./migrate": "./src/migrate.ts",
        "./testing": "./src/testing.ts"
    },
    "scripts": {
        "typecheck": "tsc -p .",
        "test": "vitest run",
        "generate": "drizzle-kit generate",
        "migrate": "tsx src/cli.ts",
        "db:up": "docker compose up -d --wait"
    },
    "dependencies": {
        "drizzle-orm": "0.45.4",
        "postgres": "3.4.9"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "drizzle-kit": "0.31.11",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "vitest": "5.1.1"
    }
}

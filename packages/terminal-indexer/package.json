{
    "name": "terminal-indexer",
    "private": true,
    "type": "module",
    "description": "Aviary's indexer: Pipeline's router history decoded into Postgres, reconciled from a cursor (docs/spec/pipescope-architecture.md, Indexer)",
    "engines": {
        "node": ">=24 <25"
    },
    "exports": {
        ".": "./src/index.ts",
        "./testing": "./test/fakeRpc.ts",
        "./testing/programs": "./test/programs.ts"
    },
    "scripts": {
        "typecheck": "tsc -p .",
        "test": "vitest run"
    },
    "dependencies": {
        "@pipeline-sol/sdk": "catalog:",
        "@solana/kit": "8.6.0",
        "drizzle-orm": "0.45.4",
        "terminal-db": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "typescript": "6.0.3",
        "vitest": "5.1.1"
    }
}

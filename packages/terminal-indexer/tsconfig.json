{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["es2023"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src", "test"]
}

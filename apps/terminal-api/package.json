{
    "name": "terminal-api",
    "private": true,
    "type": "module",
    "description": "Aviary's API Worker: Hono with a zod contract, the every-minute dispatcher and /health (docs/spec/pipescope-architecture.md, \"The two Workers\")",
    "engines": {
        "node": ">=24 <25"
    },
    "exports": {
        "./contract": "./src/contract.ts",
        "./config": "./src/config.ts",
        "./amounts": "./src/trading/amounts.ts"
    },
    "scripts": {
        "dev": "node scripts/dev.ts",
        "typecheck": "tsc -p .",
        "test": "vitest run",
        "types": "wrangler types --env-interface CloudflareBindings"
    },
    "dependencies": {
        "@cloudflare/containers": "0.3.7",
        "@pipeline-sol/sdk": "catalog:",
        "@solana-program/system": "0.16.0",
        "@solana-program/token": "0.18.0",
        "@solana/kit": "8.6.0",
        "drizzle-orm": "0.45.4",
        "hono": "4.13.20",
        "strategy-actions": "workspace:*",
        "terminal-db": "workspace:*",
        "terminal-explainer": "workspace:*",
        "terminal-indexer": "workspace:*",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "5.20261121.1",
        "@types/node": "24.19.2",
        "jsonc-parser": "3.3.1",
        "postgres": "3.4.9",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "undici": "7.30.2",
        "vitest": "5.1.1",
        "wrangler": "4.166.0"
    }
}

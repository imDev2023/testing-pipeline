// Adapted from Top-pad b833a7b, apps/web/wrangler.jsonc; owned here since.
// `terminal-web` (docs/spec/pipescope-architecture.md, "terminal-web"): the web app on Workers
// through OpenNext. `pnpm --filter terminal-web preview` builds it and runs it in `wrangler dev`
// against the local run's API. It is built per environment, since NEXT_PUBLIC_API_URL is baked in
// at build time: `pnpm terminal:deploy` builds it with the URL `terminal-api-devnet` was deployed
// at, and deploys it as `env.devnet` (#192).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terminal-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // The hosted devnet deployment, `terminal-web-devnet` on workers.dev (#192); assets are named
  // again, since wrangler carries no binding into an environment.
  "env": {
    "devnet": {
      "name": "terminal-web-devnet",
      "workers_dev": true,
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" }
    }
  }
}

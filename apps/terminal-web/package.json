{
    "name": "terminal-web",
    "private": true,
    "type": "module",
    "description": "Aviary's web app: Next.js 16 on Workers through OpenNext, a pure client of terminal-api (docs/spec/pipescope-architecture.md, \"terminal-web\")",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "next dev --port 3111",
        "build": "next build",
        "typecheck": "next typegen && tsc -p .",
        "test": "vitest run",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 3111"
    },
    "dependencies": {
        "next": "16.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "terminal-api": "workspace:*",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "1.20.18",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "typescript": "6.0.3",
        "vitest": "5.1.1",
        "wrangler": "4.166.0"
    }
}

{
    "name": "containment-hook-scripts",
    "private": true,
    "type": "module",
    "description": "The containment hook's launch script, which launches a contained token on its tax AMM home market, its conformance judge, its freeze gate, and its generated TypeScript client",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "launch": "node launch.ts",
        "freeze-gate": "node freeze-gate.ts",
        "test": "node --test",

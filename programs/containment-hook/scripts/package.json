        "client": "node codama.ts",
        "typecheck": "node codama.ts --check && tsc --noEmit"
    },
    "dependencies": {
        "@pipeline-placeholder/sdk": "link:../../../fixtures/pipeline/sdk/ts",
        "@solana-program/system": "0.16.0",
        "@solana-program/token": "0.18.0",
        "@solana-program/token-2022": "0.20.0",
        "@solana/kit": "8.6.0",
        "strategy-actions": "workspace:*"
    },
    "devDependencies": {
        "@codama/nodes-from-anchor": "1.5.6",
        "@codama/renderers-js": "2.8.0",
        "@types/node": "24.19.2",
        "codama": "1.11.0",
        "typescript": "7.0.2"
    }
}

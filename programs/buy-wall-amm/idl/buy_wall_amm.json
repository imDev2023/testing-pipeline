            ],
            "type": "u16"
          },
          {
            "name": "rewards_recipient",
            "docs": [
              "A wallet; the default key exactly when `reward_share_bps` is 0."
            ],
            "type": "pubkey"
          },
          {
            "name": "cap_floor_bps",
            "docs": [

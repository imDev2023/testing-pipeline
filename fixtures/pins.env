# What scripts/fetch-router.sh checks the fetched router against. Everything else in
# fixtures/ is fetched or built by scripts and never committed (see .gitignore).
# Pipeline's own commit is pinned once, as `rev` in programs/Cargo.toml.

# Pipeline's router and its config account (the PDA ["config"]).
ROUTER_PROGRAM=PiPEf4fFBpYXCtgfiWgVWzZNXnq2wZ7bnXidJCTwf34
ROUTER_CONFIG=BmdeX3kWjQavcjggCd1YDws67szz7iqcJRa1KebtRQZ8

# SHA-256 of `solana program dump` of the router on devnet, as deployed in slot 524,761,925
# (2026-11-21): Pipeline's 48a6b5f (Release 0.3.0), the rev in programs/Cargo.toml, whose
# solana-verify Docker build gives the same executable hash, 4500c2939465439279caa0555123b44b81c63293a35ff36a1932a7cf51c49803;
# checked on 2026-11-22. Earlier: 6a516360... (slot 523,772,247, 2026-11-18, 3fd85ce) and
# 57a93bba... (slot 520,510,501, 2026-11-09), whose commit was never checked against a verified build.
ROUTER_SHA256=17407a0db8316741bc75de73e89e2922d5bd8430bb11e589a852504c71fa3dca

# Kamino Lend (klend), which programs/lending-amm/scripts/fetch-klend.sh checks the fetched
# bytes against: SHA-256 of `solana program dump` on each cluster, checked on 2026-11-12.
# Mainnet's was deployed in slot 461,744,249, devnet's in slot 491,561,420.
KLEND_PROGRAM=KLend2g3cP87fffoy8q1mQqGKjrxjC8boSyAYavgmjD
KLEND_MAINNET_SHA256=6482390f659a6774b059768313b6f701b14819110f9e10db8fa651a311e9c97b
KLEND_DEVNET_SHA256=5f3b2634e5a3d787baf5a119e4c400a9512723787b79d289b7c17e509bbce4c5

# The Docker image scripts/deploy-devnet.sh builds every devnet deploy in: the image
# solana-verify 0.5.2 itself picks for `[workspace.metadata.cli] solana` in programs/Cargo.toml
# (its src/image_config.rs), pinned here so each deploy records exactly what built it. The
# script refuses to build when the workspace pins another Solana version; change both together.
VERIFY_SOLANA_VERSION=4.3.0
VERIFY_IMAGE=solanafoundation/solana-verifiable-build@sha256:12fd4c0a0790f0fc41ef74b0cdb6bccc167ba6137eb1adb749bac649481c86bd

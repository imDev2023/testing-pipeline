{
    "name": "testing-pipeline",
    "private": true,
    "description": "The TypeScript workspace: each program's scripts, the shared packages, and the apps (the keeper runner, Aviary's two Workers)",
    "packageManager": "pnpm@11.0.8",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "typecheck": "pnpm --recursive typecheck",
        "keeper:install": "node apps/keeper/scripts/agent.ts install",
        "keeper:uninstall": "node apps/keeper/scripts/agent.ts uninstall",
        "keeper:status": "pnpm --filter keeper status",
        "keeper:once": "pnpm --filter keeper once",
        "terminal:dev:api": "pnpm --filter terminal-api dev",
        "terminal:dev:web": "pnpm --filter terminal-web preview",
        "terminal:db:migrate": "pnpm --filter terminal-db migrate",
        "terminal:lint": "eslint apps/terminal-api apps/terminal-web packages/terminal-db tests/terminal-e2e",
        "terminal:e2e": "pnpm --filter terminal-e2e e2e"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@next/eslint-plugin-next": "16.4.6",
        "eslint": "10.15.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0"
    }
}
